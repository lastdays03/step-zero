ENVIRONMENT=development
PROJECT_NAME=StepZero API
VERSION=1.0.0
API_V1_STR=/api/v1

# Local backend/frontend dev CORS
BACKEND_CORS_ORIGINS_STR=http://localhost:3000

# Local services
DATABASE_URL=postgresql+asyncpg://stepzero_admin:stepzero_password@localhost:5432/stepzero_db
REDIS_URL=redis://localhost:6379/0

# JWT (dev only; replace for production)
SECRET_KEY=dev-secret-key-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional integrations (keep empty if not used)
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=

# Feature flags / models
ENABLE_SOCIAL_MOCK=false
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
