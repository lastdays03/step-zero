ENVIRONMENT=development
PROJECT_NAME=StepZero API
VERSION=1.0.0
API_V1_STR=/api/v1

# CORS
BACKEND_CORS_ORIGINS_STR=http://localhost:3000

# DB/Redis (local backend 실행 기본값)
POSTGRES_USER=stepzero_admin
POSTGRES_PASSWORD=stepzero_password
POSTGRES_DB=stepzero_db
DATABASE_URL=postgresql+asyncpg://stepzero_admin:stepzero_password@localhost:5432/stepzero_db
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=dev-secret-key-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional integrations
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=

# Admin (쉼표 구분, 가입 시 자동 superuser 부여)
ADMIN_EMAILS=

# Feature flags / models
ENABLE_SOCIAL_MOCK=false
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Law API (국가법령정보센터 Open API)
LAW_API_OC=

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=

# R2 (STORAGE_BACKEND=r2 시 필수)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=stepzero-uploads
R2_PUBLIC_URL=
GROWTH_CLUB_MAX_IMAGE_MB=20
GROWTH_CLUB_MAX_FILE_MB=50
GROWTH_CLUB_MAX_TOTAL_MB=200
GROWTH_CLUB_MAX_IMAGE_COUNT=10
GROWTH_CLUB_MAX_FILE_COUNT=10

# Error Tracking (GlitchTip — Sentry SDK 호환, 빈 문자열이면 비활성화)
SENTRY_DSN=

# Logging (true: JSON 출력, false: 컬러 콘솔)
LOG_JSON_OUTPUT=false
