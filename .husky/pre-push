#!/usr/bin/env sh
branch="$(git branch --show-current)"

if [ -n "$branch" ]; then
  echo "[pre-push] sync check ($branch)"
  if git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    counts="$(git rev-list --left-right --count HEAD...origin/$branch)"
    ahead="$(echo "$counts" | awk '{print $1}')"
    behind="$(echo "$counts" | awk '{print $2}')"

    if [ "$behind" -gt 0 ]; then
      echo "[pre-push] rejected: local branch is behind origin/$branch (ahead=$ahead, behind=$behind)"
      echo "Run: git fetch origin $branch && git pull --rebase origin $branch"
      exit 1
    fi
  else
    echo "[pre-push] warning: no origin/$branch tracking ref found locally"
    echo "Run: git fetch origin $branch"
  fi
fi

echo "[pre-push] running backend smoke tests + frontend lint in parallel"

(cd app-backend && uv run pytest -q -x tests/services tests/repositories tests/integration -m "not slow and not requires_openai") &
pid_backend=$!

(cd app-frontend && pnpm lint) &
pid_frontend=$!

fail=0
wait $pid_backend || { echo "[pre-push] backend tests failed"; fail=1; }
wait $pid_frontend || { echo "[pre-push] frontend lint failed"; fail=1; }

if [ "$fail" -ne 0 ]; then
  exit 1
fi

echo "[pre-push] all checks passed"
