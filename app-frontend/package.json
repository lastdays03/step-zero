{
  "name": "stepzero-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "types:backend-openapi": "docker exec -i stepzero-backend bash -lc \"cd /app && python scripts/export_openapi.py\"",
